#!/usr/bin/env bash
set -euo pipefail

# Parent dir holding grouped projects (e.g. ~/code/wekoos/crm).
# Override per-machine: export TMUX_PROJECT_ROOT="$HOME/whatever" in a non-committed rc.
ROOT="${TMUX_PROJECT_ROOT:-$HOME/code}"

# List dotfiles plus the grouped projects (parent/group/repo).
DIR=$({ echo "$HOME/dotfiles"; [ -d "$ROOT" ] && fd --type d --min-depth 2 --max-depth 2 . "$ROOT"; } \
  | fzf --prompt="Project dir: ")
[ -z "$DIR" ] && exit 0

DEFAULT_NAME=$(basename "$DIR")
read -rp "Session name [$DEFAULT_NAME]: " NAME
NAME="${NAME:-$DEFAULT_NAME}"

tmux new-session -d -s "$NAME" -c "$DIR" -n "server"
tmux new-window -t "$NAME" -c "$DIR" -n "nvim"
tmux new-window -t "$NAME" -c "$DIR" -n "claude"
tmux new-window -t "$NAME" -c "$DIR" -n "shell"
tmux select-window -t "$NAME:1"

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$NAME"
else
  tmux attach-session -t "$NAME"
fi
